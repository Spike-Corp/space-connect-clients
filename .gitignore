# Build outputs
build/
deploy/
# ...but keep the Linux AppImage packaging SOURCE files under app/deploy/linux
# (the broad "deploy/" rule above would otherwise ignore them and break the
# AppImage build from a clean checkout / CI). Everything else under app/deploy
# (e.g. steamlink) stays ignored.
!desktop/app/deploy/
desktop/app/deploy/*
!desktop/app/deploy/linux/
!desktop/app/deploy/linux/**
**/*.o
**/moc_*.cpp
**/moc_*.h
**/qrc_*.cpp
**/*.pro.user
**/.qmake.stash
desktop/**/debug/
desktop/**/release/
desktop/**/Makefile
desktop/**/Makefile.*

# Android
android/.gradle/
android/app/build/
android/local.properties
android/**/*.iml

# mic-bridge (.NET)
mic-bridge/bin/
mic-bridge/obj/

# Secrets / signing (never commit)
*.jks
*.keystore
*.p12
*.mobileprovision
*-signing.env
*.env

# OS cruft
.DS_Store
Thumbs.db
.github/workflows/build-desktop.yml
