<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="88dp"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/login_app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_spacecloud_brandbook" />

        <TextView
            android:id="@+id/launcherUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/appForegroundColor"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/launcherAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/appMutedForegroundColor"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/launcherStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launcher_loading"
                android:textColor="?attr/appForegroundColor"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launcherDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/appMutedForegroundColor"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/launcherProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:indeterminate="true" />

            <Button
                android:id="@+id/launcherPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_purple"
                android:text="@string/launcher_wait"
                android:textAllCaps="false"
                android:textColor="@color/moonlight_gold_foreground"
                android:textStyle="bold" />

            <Button
                android:id="@+id/launcherEndSessionButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="@string/launcher_end_session"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/launcherControllerButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/launcher_shortcut_controller"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_gamepad" />

            <ImageButton
                android:id="@+id/launcherUploadButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/launcher_upload_file"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_upload" />

            <ImageButton
                android:id="@+id/launcherSettingsButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/launcher_shortcut_settings"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/launcherNetworkButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/launcher_latency_test"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_speed" />
        </LinearLayout>

        <Button
            android:id="@+id/launcherRefreshButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:textColor="@color/moonlight_foreground"
            android:textSize="15sp"
            android:text="@string/launcher_refresh"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/launcherLogoutButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:textColor="@color/moonlight_danger"
            android:textSize="15sp"
            android:text="@string/launcher_logout"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
