<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/launcherToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@color/moonlight_surface"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/launcherTopLogo"
            android:layout_width="112dp"
            android:layout_height="40dp"
            android:contentDescription="@string/launcher_toolbar_title"
            android:scaleType="centerInside"
            android:src="@drawable/logo_spacecloud_brandbook" />

        <TextView
            android:id="@+id/launcherToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/launcher_toolbar_title"
            android:textColor="?attr/appMutedForegroundColor"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/launcherNetworkHeaderButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_button_ghost"
            android:contentDescription="@string/launcher_latency_test"
            android:padding="11dp"
            android:src="@drawable/ic_network"
            android:tint="@color/moonlight_foreground" />

        <ImageButton
            android:id="@+id/launcherHelpButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_ghost"
            android:contentDescription="@string/launcher_help"
            android:padding="11dp"
            android:src="@drawable/ic_help"
            android:tint="@color/moonlight_foreground" />

        <ImageButton
            android:id="@+id/launcherBugButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_ghost"
            android:contentDescription="@string/bug_report_title"
            android:padding="11dp"
            android:src="@drawable/ic_bug"
            android:tint="@color/moonlight_foreground" />

        <ImageButton
            android:id="@+id/launcherSettingsHeaderButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_ghost"
            android:contentDescription="@string/launcher_shortcut_settings"
            android:padding="11dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/moonlight_foreground" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="26dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/launcherUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launcher_greeting"
                android:textColor="?attr/appForegroundColor"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launcherAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="?attr/appMutedForegroundColor"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/launcherStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_status_dot" />

                    <TextView
                        android:id="@+id/launcherStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/launcher_loading"
                        android:textColor="@color/moonlight_teal"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/launcherProgress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminateTint="@color/moonlight_purple"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/launcherDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/launcher_idle_details"
                    android:textColor="?attr/appMutedForegroundColor"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/launcherPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_purple"
                android:text="@string/launcher_join_queue"
                android:textAllCaps="false"
                android:textColor="@color/moonlight_gold_foreground"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/launcherEndSessionButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_danger"
                android:text="@string/launcher_end_session"
                android:textAllCaps="false"
                android:textColor="@color/moonlight_danger"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/launcher_tools_title"
                android:textColor="?attr/appMutedForegroundColor"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/launcherUploadButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_ghost"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:text="@string/launcher_upload_file"
                android:textAllCaps="false"
                android:textColor="?attr/appForegroundColor"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/launcherControllerButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_ghost"
                    android:text="@string/launcher_shortcut_controller"
                    android:textAllCaps="false"
                    android:textColor="?attr/appForegroundColor"
                    android:textSize="12sp"
                    android:singleLine="false"
                    android:maxLines="2"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <Button
                    android:id="@+id/launcherSettingsButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_ghost"
                    android:text="@string/launcher_shortcut_settings"
                    android:textAllCaps="false"
                    android:textColor="?attr/appForegroundColor"
                    android:textSize="12sp"
                    android:singleLine="false"
                    android:maxLines="2"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <Button
                    android:id="@+id/launcherNetworkButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_ghost"
                    android:text="@string/launcher_latency_test"
                    android:textAllCaps="false"
                    android:textColor="?attr/appForegroundColor"
                    android:textSize="12sp"
                    android:singleLine="false"
                    android:maxLines="2"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/launcherRefreshButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:text="@string/launcher_refresh"
                    android:textAllCaps="false"
                    android:textColor="@color/moonlight_purple"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/launcherLogoutButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:text="@string/launcher_logout"
                    android:textAllCaps="false"
                    android:textColor="@color/moonlight_danger"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
