<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/login_app_name"
            android:textColor="@color/moonlight_purple"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/launcherAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/appMutedForegroundColor"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/launcherStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launcher_loading"
                android:textColor="?attr/appForegroundColor"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launcherDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="?attr/appMutedForegroundColor"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/launcherProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:indeterminate="true" />

            <Button
                android:id="@+id/launcherPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button_purple"
                android:text="@string/launcher_wait"
                android:textAllCaps="false"
                android:textColor="@color/moonlight_gold_foreground"
                android:textStyle="bold" />

            <Button
                android:id="@+id/launcherEndSessionButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/launcher_end_session"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/launcherRefreshButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="@string/launcher_refresh"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/launcherLogoutButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/launcher_logout"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
