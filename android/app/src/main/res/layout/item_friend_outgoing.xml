<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/friendOutgoingAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="yes"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/friendOutgoingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/moonlight_foreground"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/friendOutgoingUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/moonlight_muted_foreground"
            android:textSize="11sp" />

        <com.limelight.account.RgbRoleBadgeView
            android:id="@+id/friendOutgoingRole"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/friends_waiting"
        android:textColor="@color/moonlight_muted_foreground"
        android:textSize="12sp" />
</LinearLayout>
