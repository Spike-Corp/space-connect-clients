<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/dlName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/moonlight_foreground"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dlDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/moonlight_foreground"
        android:alpha="0.85"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/dlMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/moonlight_muted_foreground"
        android:textSize="11sp" />

    <Button
        android:id="@+id/dlActionButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_purple"
        android:textColor="@color/moonlight_gold_foreground"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
