<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <TextView
            android:id="@+id/loginWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/login_app_name"
            android:textColor="@color/moonlight_purple"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/loginSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp"
            android:text="@string/login_subtitle"
            android:textColor="?attr/appMutedForegroundColor"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp">

            <EditText
                android:id="@+id/emailField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="@string/login_email_hint"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:drawableStart="@drawable/ic_account"
                android:drawablePadding="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textColor="?attr/appForegroundColor"
                android:textColorHint="?attr/appMutedForegroundColor" />

            <EditText
                android:id="@+id/passwordField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/login_password_hint"
                android:inputType="textPassword"
                android:singleLine="true"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textColor="?attr/appForegroundColor"
                android:textColorHint="?attr/appMutedForegroundColor" />

            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_purple"
                android:text="@string/login_button"
                android:textColor="@color/moonlight_gold_foreground"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>

        <TextView
            android:id="@+id/createAccountLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login_create_account"
            android:textColor="@color/moonlight_teal"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/forgotPasswordLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_forgot_password"
            android:textColor="?attr/appMutedForegroundColor"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
