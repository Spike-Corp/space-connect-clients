<?xml version="1.0" encoding="utf-8"?>
<!-- Splash / launch screen. The gradient behind everything here comes automatically from the
     app theme's windowBackground (bg_app_gradient on Dark, flat color on Light) - this layout
     only adds the skyline silhouette + tribute signage + the animated logo/tip content on top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/bg_skyline_silhouette"
        android:contentDescription="@null"/>

    <!-- Hidden tribute: a small neon "rooftop sign" over the skyline, referencing the user's
         husky Ralph das Neves and the "servers cold as snow" tagline. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="96dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:alpha="0.9">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ralph das Neves"
            android:textColor="@color/moonlight_teal"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:textSize="11sp"
            android:shadowColor="@color/moonlight_teal"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"/>

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_snowflake"
            android:contentDescription="@null"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_splash_logo"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/splashWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_app_name"
            android:textColor="@color/moonlight_foreground"
            android:textStyle="bold"
            android:textSize="28sp"/>

        <ImageView
            android:id="@+id/splashSpinner"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/ic_loader"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/splashTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/moonlight_muted_foreground"
            android:textSize="13sp"
            android:gravity="center"/>

    </LinearLayout>

</FrameLayout>
