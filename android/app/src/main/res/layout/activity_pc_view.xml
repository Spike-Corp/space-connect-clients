<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical"
    tools:context=".PcView">

    <LinearLayout
        android:id="@+id/pcToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@color/moonlight_surface"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="40dp"
            android:contentDescription="@string/launcher_toolbar_title"
            android:scaleType="centerInside"
            android:src="@drawable/logo_spacecloud_brandbook" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/pcs_title"
            android:textColor="?attr/appForegroundColor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pcHomeButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:text="@string/launcher_home"
            android:textAllCaps="false"
            android:textColor="@color/moonlight_purple"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_ghost"
            android:contentDescription="@string/launcher_shortcut_settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/gamesButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_ghost"
            android:contentDescription="@string/games_button_description"
            android:padding="10dp"
            android:src="@drawable/ic_games" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <RelativeLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingStart="@dimen/activity_horizontal_margin"
            android:paddingEnd="@dimen/activity_horizontal_margin">

            <ImageView
                android:id="@+id/pcs_loading"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_loader" />

            <ImageView
                android:id="@+id/pcs_loading_pulse"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignTop="@id/pcs_loading"
                android:layout_alignBottom="@id/pcs_loading"
                android:layout_alignStart="@id/pcs_loading"
                android:layout_alignEnd="@id/pcs_loading"
                android:layout_margin="23dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_signal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/pcs_loading"
                android:layout_marginStart="10dp"
                android:text="@string/searching_pc"
                android:textColor="?attr/appMutedForegroundColor"
                android:textSize="16sp" />
        </RelativeLayout>
    </FrameLayout>
</LinearLayout>
