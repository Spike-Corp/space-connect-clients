<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:id="@+id/streamSideReservedArea"
        android:layout_width="@dimen/stream_side_handle_size"
        android:layout_height="match_parent"
        android:contentDescription="@string/stream_side_reserved"
        android:visibility="invisible" />

    <ScrollView
        android:id="@+id/streamSidePanel"
        android:layout_width="@dimen/stream_side_panel_width"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clickable="true"
        android:focusable="true"
        android:visibility="invisible">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/stream_side_gap"
            android:orientation="vertical">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="@dimen/stream_side_gap"
                android:scaleType="fitCenter"
                android:src="?attr/appLogoDrawable"
                android:contentDescription="@string/app_label" />
            <Button
                android:id="@+id/streamSideKeyboard"
                style="@style/StreamSideAction"
                android:drawableTop="@drawable/ic_keyboard"
                android:text="@string/stream_side_keyboard"
                android:contentDescription="@string/stream_side_keyboard_desc" />
            <Button
                android:id="@+id/streamSideOptions"
                style="@style/StreamSideAction"
                android:drawableTop="@drawable/ic_game_menu"
                android:text="@string/stream_side_options"
                android:contentDescription="@string/game_menu_button_desc" />
            <Button
                android:id="@+id/streamSideMicrophone"
                style="@style/StreamSideAction"
                android:text="@string/stream_side_microphone"
                android:contentDescription="@string/stream_side_mic_off" />
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/streamSideHandle"
        android:layout_width="@dimen/stream_side_handle_size"
        android:layout_height="@dimen/stream_side_handle_size"
        android:src="@drawable/ic_stream_side_arrow"
        android:contentDescription="@string/stream_side_open"
        android:visibility="invisible" />
</merge>
