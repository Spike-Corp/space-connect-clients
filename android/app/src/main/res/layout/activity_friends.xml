<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/friendsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@color/moonlight_surface"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/friendsBackButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_button_ghost"
            android:contentDescription="@string/back"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            android:tint="@color/moonlight_foreground" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/friends_title"
            android:textColor="@color/moonlight_foreground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BETA"
            android:textColor="@color/moonlight_teal"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/friendsProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:indeterminateTint="@color/moonlight_purple"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/friendsMyAvatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="yes"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/friendsMyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/friends_your_profile"
                        android:textColor="@color/moonlight_foreground"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/friendsMyUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/moonlight_muted_foreground"
                        android:textSize="12sp" />

                    <com.limelight.account.RgbRoleBadgeView
                        android:id="@+id/friendsMyRole"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginTop="4dp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:visibility="gone" />
                </LinearLayout>

                <Button
                    android:id="@+id/friendsEditUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_ghost"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/friends_edit_username"
                    android:textAllCaps="false"
                    android:textColor="@color/moonlight_foreground" />
            </LinearLayout>

            <Button
                android:id="@+id/friendsRequestToggle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_ghost"
                android:textAllCaps="false"
                android:textColor="@color/moonlight_foreground"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/friendsAddField"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    android:hint="@string/friends_add_hint"
                    android:inputType="text"
                    android:maxLength="20"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/moonlight_foreground"
                    android:textColorHint="@color/moonlight_muted_foreground"
                    android:background="@drawable/bg_input_field" />

                <Button
                    android:id="@+id/friendsAddButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_purple"
                    android:textColor="@color/moonlight_gold_foreground"
                    android:textAllCaps="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/friends_search" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/friendsSearchResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/friendsSearchAvatar"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:importantForAccessibility="yes"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/friendsSearchName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/moonlight_foreground"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/friendsSearchUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/moonlight_muted_foreground"
                            android:textSize="12sp" />

                        <com.limelight.account.RgbRoleBadgeView
                            android:id="@+id/friendsSearchRole"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginTop="4dp"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/friendsSearchHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/friends_search_hint"
                    android:textColor="@color/moonlight_muted_foreground"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/friendsSearchAction"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_purple"
                    android:textAllCaps="false"
                    android:textColor="@color/moonlight_gold_foreground" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/friendsIncoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/friendsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/friends_empty"
                android:textColor="@color/moonlight_muted_foreground"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/friendsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/friends_shared_title"
                android:textColor="@color/moonlight_foreground"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/friends_shared_hint"
                android:textColor="@color/moonlight_muted_foreground"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/friendsMachines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
