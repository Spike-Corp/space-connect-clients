<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_button_ghost"
        android:contentDescription="@null"
        android:padding="14dp"
        android:src="@drawable/ic_shield_check" />

    <TextView
        android:id="@+id/twoFactorTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/launcher_two_factor_title"
        android:textColor="?attr/appForegroundColor"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/twoFactorDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/launcher_two_factor_description"
        android:textColor="?attr/appMutedForegroundColor"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/launcher_two_factor_label"
            android:textColor="?attr/appMutedForegroundColor"
            android:textSize="13sp" />

        <Button
            android:id="@+id/twoFactorPasteButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/launcher_two_factor_paste"
            android:textAllCaps="false"
            android:textColor="@color/moonlight_gold"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/twoFactorCodeField"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center"
        android:hint="@string/launcher_two_factor_hint"
        android:inputType="number"
        android:maxLength="6"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="?attr/appForegroundColor"
        android:textColorHint="?attr/appMutedForegroundColor"
        android:textSize="25sp"
        android:letterSpacing="0.12" />

    <TextView
        android:id="@+id/twoFactorError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/moonlight_danger"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/twoFactorConfirmButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_purple"
        android:text="@string/launcher_confirm"
        android:textAllCaps="false"
        android:textColor="@color/moonlight_gold_foreground"
        android:textStyle="bold" />

    <Button
        android:id="@+id/twoFactorBackButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@android:color/transparent"
        android:text="@string/launcher_two_factor_back"
        android:textAllCaps="false"
        android:textColor="@color/moonlight_purple"
        android:textSize="13sp" />
</LinearLayout>
