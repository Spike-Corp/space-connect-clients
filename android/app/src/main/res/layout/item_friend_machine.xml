<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/friendMachineName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/moonlight_foreground"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/friendMachineMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/moonlight_muted_foreground"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/friendMachineConnect"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/bg_button_purple"
        android:textColor="@color/moonlight_gold_foreground"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:text="@string/friends_connect" />
</LinearLayout>
