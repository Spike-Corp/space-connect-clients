<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/friendRequestName"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:textColor="@color/moonlight_foreground"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/friendRequestAccept"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_teal"
        android:textColor="@color/moonlight_gold_foreground"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:text="@string/friends_accept" />

    <Button
        android:id="@+id/friendRequestDecline"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_button_ghost"
        android:textColor="@color/moonlight_foreground"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:text="@string/friends_decline" />
</LinearLayout>
