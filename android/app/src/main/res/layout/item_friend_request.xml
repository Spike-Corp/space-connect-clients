<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/friendRequestAvatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:importantForAccessibility="yes"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/friendRequestName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/appForegroundColor"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/friendRequestUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/appMutedForegroundColor"
                android:textSize="11sp" />

            <com.limelight.account.RgbRoleBadgeView
                android:id="@+id/friendRequestRole"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="4dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/friendRequestAccept"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_teal"
            android:text="@string/friends_accept"
            android:textAllCaps="false"
            android:textColor="@color/moonlight_gold_foreground"
            android:textSize="12sp" />

        <Button
            android:id="@+id/friendRequestDecline"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_ghost"
            android:text="@string/friends_decline"
            android:textAllCaps="false"
            android:textColor="?attr/appForegroundColor"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
