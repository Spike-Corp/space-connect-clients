<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vmManagementRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/appBackgroundDrawable" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="88dp" android:layout_height="44dp"
            android:src="?attr/appLogoDrawable" android:contentDescription="@string/launcher_toolbar_title"
            android:scaleType="centerInside" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/vm_management" android:textSize="20sp"
            android:textStyle="bold" android:textColor="?attr/appForegroundColor" />
        <Button android:id="@+id/vmManagementBack" android:layout_width="wrap_content" android:layout_height="48dp"
            android:background="@drawable/bg_button_ghost" android:text="@string/vm_back" android:textAllCaps="false"
            android:textColor="?attr/appForegroundColor" />
    </LinearLayout>
    <TextView android:id="@+id/vmManagementStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="12dp" android:paddingBottom="12dp" android:text="@string/vm_loading"
        android:textColor="?attr/appMutedForegroundColor" android:accessibilityLiveRegion="polite" />
    <ScrollView android:id="@+id/vmManagementScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/vmManagementList" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
