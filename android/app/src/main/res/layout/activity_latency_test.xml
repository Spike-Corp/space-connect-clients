<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@drawable/bg_app_gradient">

    <TextView
        android:id="@+id/latencyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/latency_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/moonlight_foreground" />

    <TextView
        android:id="@+id/latencyResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="—"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="@color/moonlight_gold" />

    <TextView
        android:id="@+id/latencyVerdict"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/moonlight_teal" />

    <TextView
        android:id="@+id/latencyDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="@color/moonlight_muted_foreground"
        android:text="@string/latency_hint" />

    <ProgressBar
        android:id="@+id/latencyProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/latencyStart"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_button_purple"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:textColor="@color/moonlight_gold_foreground"
        android:textAllCaps="false"
        android:text="@string/latency_start" />

</LinearLayout>
