<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical"
    tools:context=".AppView">

    <LinearLayout
        android:id="@+id/appToolbar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/moonlight_surface"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="108dp"
            android:layout_height="48dp"
            android:contentDescription="@string/launcher_toolbar_title"
            android:scaleType="centerInside"
            android:src="@drawable/logo_spacecloud_brandbook" />

        <TextView
            android:id="@+id/appToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="?attr/appForegroundColor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/appHomeButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:text="@string/launcher_home"
            android:textAllCaps="false"
            android:textColor="@color/moonlight_purple"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/appSettingsButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_ghost"
            android:contentDescription="@string/launcher_shortcut_settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/appListText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textSize="22sp"
        android:textColor="?attr/appForegroundColor"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center" />
</LinearLayout>
