<?xml version="1.0" encoding="utf-8"?>
<!-- Banner do Sudo Maker (modo Desempenho): fundo roxo translúcido + borda roxa pra
     destacar os benefícios do modo de vídeo de alta performance. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#2A1D4A"
        android:endColor="#1C1733"/>
    <stroke
        android:width="1dp"
        android:color="@color/moonlight_purple"/>
    <corners android:radius="12dp"/>
</shape>
