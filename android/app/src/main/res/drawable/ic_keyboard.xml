        android:fillColor="@color/moonlight_foreground"
        android:fillType="evenOdd"
        android:pathData="M2,6 h20 v11 h-20 z M4,8 h16 v7 h-16 z"/>
    <!-- Keys -->
    <path
        android:fillColor="@color/moonlight_foreground"
        android:pathData="M5,9 h2 v2 h-2z M8,9 h2 v2 h-2z M11,9 h2 v2 h-2z M14,9 h2 v2 h-2z M17,9 h2 v2 h-2z
