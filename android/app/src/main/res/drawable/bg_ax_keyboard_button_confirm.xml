<?xml version="1.0" encoding="utf-8"?>
<!-- Background for keys on the full on-screen keyboard (KeyBoardLayoutController) while pressed -
     highlighted accent fill used as touch-down feedback. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/moonlight_purple"/>
    <stroke
        android:width="1dp"
        android:color="@color/moonlight_purple_shadow"/>
    <corners android:radius="4dp"/>
</shape>
