<?xml version="1.0" encoding="utf-8"?>
<!-- Space Cloud primary CTA button: brand purple -> blue diagonal gradient fill + thin bright
     outline, rounded corners - matches the web client's primary call-to-action. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/moonlight_purple"
                android:endColor="@color/moonlight_blue"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke
                android:width="@dimen/cartoon_border_width"
                android:color="@color/moonlight_purple"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</layer-list>
