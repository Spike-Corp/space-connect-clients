<?xml version="1.0" encoding="utf-8"?>
<!-- Default background for keys on the full on-screen keyboard (KeyBoardLayoutController):
     dark surface fill with a thin accent border, subtly rounded corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/moonlight_surface_2"/>
    <stroke
        android:width="1dp"
        android:color="@color/moonlight_border"/>
    <corners android:radius="4dp"/>
</shape>
