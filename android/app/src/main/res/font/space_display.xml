<?xml version="1.0" encoding="utf-8"?>
<!-- Space Cloud display/heading font = Bai Jamjuree (brand heading typeface), embedded from the
     web client fonts. Used for titles, the wordmark and section headers (API 26+; graceful
     fallback below). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/bai_jamjuree_regular" />
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/bai_jamjuree_medium" />
    <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/bai_jamjuree_semibold" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/bai_jamjuree_bold" />
</font-family>
