<?define ShortName = "Space Connect" ?>
<?define FullName = "Space Connect Streaming Client" ?>

<?define ShortcutName = "$(var.ShortName)" ?>
<?define ShortcutDesc = "Stream games and other applications from another PC" ?>
<?define InstallFolder = "Space Connect" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="$(var.FullName)"
           Language="1033"
           Version="!(bind.fileVersion.MoonlightExe)"
           Manufacturer="Space Connect"
           UpgradeCode="c3c38c26-16ee-4823-b448-de05a9e5b6ca">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." Schedule="afterInstallInitialize" />
    <MediaTemplate CompressionLevel="high" EmbedCab="yes" />

    <Property Id="MPSSVC_START">
      <RegistrySearch Id="MpsSvcStart"
                      Root="HKLM"
                      Key="System\CurrentControlSet\Services\MpsSvc"
                      Name="Start"
                      Type="raw" />
    </Property>

    <Launch Condition="Installed OR MPSSVC_START=&quot;#2&quot;"
            Message="Setup cannot proceed because the Windows Firewall service has been improperly disabled or stopped. You must start the Windows Firewall service (MpsSvc) to continue. If you would like to disable Windows Firewall properly, use the Windows Firewall options in Control Panel." />

    <Property Id="APPDATAFOLDER" Value="%LOCALAPPDATA%\Space Connect" />

    <!-- Default for the "add desktop shortcut" flag. Only the raw Moonlight.msi
         is actually published to users today (see spaceConnectReleases.ts /
         the download page); MoonlightSetup/Bundle.wxs, which is the ONLY place
         that ever set ADDDESKTOPSHORTCUT (via the checkbox), is not shipped.
         Without this default the property stayed undefined on every real
         install, so both Condition="ADDDESKTOPSHORTCUT=1" below evaluated
         false AND the (now-removed) integer RegistryValue that persisted this
         flag was written as an empty string — a likely contributor to the
         "Could not write value ... insufficient access" install crash some
         users hit. Defaulting to "1" restores the intended "shortcut on by
         default" behavior for direct .msi installs too. -->
    <Property Id="ADDDESKTOPSHORTCUT" Value="1" />

    <!-- There's no way to delete a registry key on uninstall but not major upgrade, so
        we have to roll our own deletion via custom action. This is a per-machine
        install (ProgramFiles6432Folder). Most of our own tracking data lives
        under HKLM now (see the RegistryValue comments further down), but the
        optional desktop shortcut's KeyPath is still forced under HKCU by
        ICE43 (non-advertised shortcut requirement), so we clean up BOTH
        hives on uninstall/major-upgrade: Impersonate="no" below so the
        deferred action runs with the elevated install token instead of the
        invoking user's, which would otherwise lack rights to HKLM. -->
    <CustomAction Id="DeleteRegistryKey"
                  Directory="ProgramFiles6432Folder"
                  ExeCommand="reg.exe delete &quot;HKLM\Software\Space Connect&quot; /f"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />
    <!-- Cleans up HKCU\Software\Space Connect: covers both legacy installs
         from before the HKLM move below, and the current DesktopShortcutInstalled
         key (still HKCU, required by ICE43; see MoonlightDesktopShortcut). -->
    <CustomAction Id="DeleteLegacyUserRegistryKey"
                  Directory="ProgramFiles6432Folder"
                  ExeCommand="reg.exe delete &quot;HKCU\Software\Space Connect&quot; /f"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="yes" />

    <!-- Writes the "DesktopShortcutInstallState" bookkeeping value (read back by
         Bundle.wxs to default the desktop-shortcut checkbox on future upgrades).
         This used to be a plain <RegistryValue> KeyPath under HKMU on an
         always-installed component (MoonlightDesktopShortcutState, ran on 100%
         of installs, unlike the conditional MoonlightDesktopShortcut below).
         MSI treats a native RegistryValue write failure as fatal and rolls back
         the WHOLE install, which is exactly the "Could not write value Desktop
         ShortcutInstallState to key \Software\Space Connect... insufficient
         access" crash reported by users — for a value that is purely cosmetic
         and never read by the app itself. Rewritten as a deferred, best-effort
         reg.exe call (Return="ignore", same forgiving pattern as the two
         delete actions above) so a permission hiccup on this one throwaway key
         (AV/EDR heuristics, leftover ACLs from very old installs, etc.) can
         never block setup again. Impersonate="no" so it runs with the elevated
         install token, matching DeleteRegistryKey above. -->
    <CustomAction Id="SetDesktopShortcutInstallStateData"
                  Property="SetDesktopShortcutInstallState"
                  Value="[ADDDESKTOPSHORTCUT]" />
    <CustomAction Id="SetDesktopShortcutInstallState"
                  Directory="ProgramFiles6432Folder"
                  ExeCommand="reg.exe add &quot;HKLM\Software\Space Connect&quot; /v DesktopShortcutInstallState /t REG_DWORD /d [CustomActionData] /f"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <InstallExecuteSequence>
      <Custom Action="DeleteRegistryKey"
              Before="InstallFinalize"
              Condition="Installed AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="DeleteLegacyUserRegistryKey"
              Before="InstallFinalize"
              Condition="Installed AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="SetDesktopShortcutInstallStateData"
              Before="SetDesktopShortcutInstallState"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="SetDesktopShortcutInstallState"
              Before="InstallFinalize"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <Component Id="MoonlightDesktopShortcut" Directory="INSTALLFOLDER" Condition="ADDDESKTOPSHORTCUT=1">
      <Shortcut Id="DesktopShortcut"
                Name="$(var.ShortcutName)"
                Description="$(var.ShortcutDesc)"
                Target="[#MoonlightExe]"
                Directory="DesktopFolder"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanupDesktopShortcut"
                    Directory="DesktopFolder"
                    On="uninstall" />
      <!-- Unlike the Start Menu shortcut (see the "Moonlight" component
           below), this one can't be made "Advertise=yes" to drop its
           registry KeyPath: WiX/MSI only allow an advertised shortcut when
           it's nested inside the File that is its *own* component's KeyPath,
           and this shortcut has to stay in its own component so it can be
           conditional on ADDDESKTOPSHORTCUT (the exe file itself must always
           install). For a non-advertised shortcut, ICE43 hard-requires the
           owning component's KeyPath to be a registry key under HKCU; HKLM
           and HKMU both fail the build (confirmed twice in CI, see
           https://learn.microsoft.com/windows/win32/msi/ice43 and /ice57).
           This does mean this one specific key can still hit the original
           per-machine/HKCU install bug on some machines, but only when the
           desktop-shortcut checkbox is on; the always-created Start Menu
           shortcut (100% of installs) no longer touches HKCU at all. -->
      <RegistryValue Root="HKCU"
                     Key="Software\Space Connect"
                     Name="DesktopShortcutInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- "DesktopShortcutInstallState" bookkeeping value is now written by the
         best-effort SetDesktopShortcutInstallState deferred CustomAction above
         (InstallExecuteSequence), not by a native RegistryValue component, so
         a write failure can no longer fail the whole install. See the
         CustomAction definitions near the top of this file for the full
         rationale. -->

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="Moonlight">
        <File Id="MoonlightExe"
              KeyPath="yes"
              Checksum="yes"
              Source="$(var.BuildDir)\app\$(var.Configuration)\SpaceConnect.exe">
          <fire:FirewallException Id="MoonlightFirewallException"
                                  Scope="any"
                                  IgnoreFailure="yes"
                                  Name="$(var.FullName)" />
          <!-- Advertised (no Target=, per WiX/ICE43) instead of a plain
               non-advertised shortcut: this keeps this component's KeyPath as
               the File itself, with no registry entry needed at all for the
               shortcut. Non-advertised shortcuts force ICE43 to require a
               HKCU KeyPath (https://learn.microsoft.com/windows/win32/msi/ice43),
               and per-machine elevated installs writing to HKCU is exactly
               what broke installs on some machines before ("Could not write
               value... Verify that you have sufficient access to that key",
               HKCU resolving to the locked-down HKEY_USERS\.DEFAULT hive).
               Since this shortcut is unconditional (always installed, unlike
               the Desktop one below), advertising it removes that whole
               crash vector for every single install. -->
          <Shortcut Id="StartMenuShortcut"
                    Name="$(var.ShortcutName)"
                    Description="$(var.ShortcutDesc)"
                    Advertise="yes"
                    Directory="ApplicationProgramsFolder"
                    WorkingDirectory="INSTALLFOLDER" />
        </File>
        <RemoveFolder Id="CleanupStartMenuShortcut"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <util:RemoveFolderEx Id="CleanupAppDataFolder"
                             On="uninstall"
                             Property="APPDATAFOLDER" />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="MoonlightDependencies" Directory="INSTALLFOLDER">
      <!-- SpaceConnect.exe is excluded: it's already harvested explicitly above
           as the "Moonlight" component. DeployDir also contains a copy of the
           exe (needed for the portable zip build step), so without this
           exclusion WiX generates a duplicate GUID for the same file. -->
      <Files Include="$(var.DeployDir)\**">
        <Exclude Files="$(var.DeployDir)\SpaceConnect.exe" />
      </Files>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="Space Connect" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="Moonlight" />
      <ComponentRef Id="MoonlightDesktopShortcut" />
      <ComponentGroupRef Id="MoonlightDependencies" />
    </Feature>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolder)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(var.InstallFolder)" />
    </StandardDirectory>
  </Package>
</Wix>
